# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=stall
# Optional: minutes from UTC for "today" (default 330 = India)
# STALL_UTC_OFFSET_MINUTES=330
# 4-digit PIN to open /tracker. Change it to log every device out.
TRACKER_PIN=1001
